    "motion": [{ "trigger": "scroll", "purpose": "explain_focus", "tier": "micro" }]
  },
  "DocAdmonition": {
    "id": "C:DOC-ADMONITION",
    "tier": "T2",
    "source": "src/components/DocAdmonition.vue",
