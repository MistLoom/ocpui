    "handlesStates": ["ready"]
  },
  "DocCodeBlock": {
    "id": "C:DOC-CODE-BLOCK",
    "tier": "T2",
    "source": "src/components/DocCodeBlock.vue",
    "duty": "代码高亮、复制、行号",
    "handlesStates": ["ready"]
  },
  "DocReadingPrefs": {
    "id": "C:DOC-READING-PREFS",
    "tier": "T2",
    "source": "src/components/DocReadingPrefs.vue",
    "duty": "字号、行宽、行高微调",
    "handlesStates": ["ready"]
  },
  "DocGlossaryTerm": {
    "id": "C:DOC-GLOSSARY-TERM",
