    "composes": ["C:MARKDOWN-BODY", "C:DOC-MARKDOWN-EDITOR", "C:DOC-VISUAL-EDITOR", "C:DOC-FRONTMATTER-PANEL"]
  },
  "DocVisualEditor": {
    "id": "C:DOC-VISUAL-EDITOR",
    "tier": "T2",
    "source": "src/components/DocVisualEditor.vue",
