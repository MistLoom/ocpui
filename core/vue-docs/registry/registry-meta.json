    "handlesStates": ["ready", "empty"],
    "dispatchRole": "chrome-host",
    "composes": ["Tree"]
  },
  "DocReaderShell": {
    "id": "C:DOC-READER-SHELL",
    "tier": "T3",
    "source": "src/components/DocReaderShell.vue",
