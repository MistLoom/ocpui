    "dispatchRole": "focus-host",
    "presentationMode": "read",
    "composes": ["C:MARKDOWN-BODY", "C:DOC-TOC", "C:DOC-READING-PREFS"]
  },
  "DocWikiShell": {
    "id": "C:DOC-WIKI-SHELL",
    "tier": "T3",
