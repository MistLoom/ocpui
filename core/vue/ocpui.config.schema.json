{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ocpui.dev/schema/ocpui.config.json",
  "title": "OCP UI 消费方配置",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "overridesDir": {
      "type": "string",
      "description": "ocp add 输出与本地覆盖组件目录，默认 src/ui-overrides"
    },
    "registry": {
      "type": "string",
      "description": "registry manifest 路径，默认 node_modules/@ocpui/vue/registry/manifest.json"
    },
    "themeStyle": {
      "type": "string",
      "enum": ["tech", "editorial"],
      "description": "默认主题风格"
    },
    "surface": {
      "type": "string",
      "enum": ["list", "detail", "form", "overlay", "chart"],
      "description": "UiScenarioScope 默认 surface preset"
    },
    "scene": {
      "type": "string",
      "enum": ["workbench", "settings", "editor", "audit"],
      "description": "UiScenarioScope 默认 scene preset"
    },
    "localeCode": {
      "type": "string",
      "enum": ["zh-CN", "en"],
      "description": "组件库默认 locale"
    }
  }
}
