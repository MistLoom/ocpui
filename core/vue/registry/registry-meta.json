  "components": {
    "AdminPage": {
      "surfaces": ["list", "detail", "form", "chart"],
      "scenes": ["workbench", "settings", "audit", "editor"],
      "composes": ["PageHeader", "SizeScope", "UiScenarioScope"],
      "slots": ["header", "tabs", "toolbar", "default", "extra"],
      "antiPatterns": ["页根 padding", "自建 __header 样式块", "绕过 SizeScope 的 toolbar 控件"],
      "localeKeys": ["navigation.pageHeader.*"],
      "duty": "承载后台页面布局分区与主内容焦点",
      "dispatchRole": "focus-host",
      "decisions": [
        {"intent": "让工具栏与主内容焦点分离", "sceneRef": "列表 CRUD 并行筛选与浏览", "manifestation": "#toolbar 使用 SizeScope sm，Body 为 focus-host"},
        {"intent": "让 surface/scene 在 Shell 内可局部覆盖", "sceneRef": "同页多区域 preset 不同", "manifestation": "内嵌 UiScenarioScope 传播 data-ui-surface"},
        {"intent": "禁止页根多余 padding 破坏 Shell rhythm", "sceneRef": "迁移旧页面样式", "manifestation": "antiPattern 页根 padding"}
      ]
    },
    "AdminWorkList": {
      "surfaces": ["list"],
      "scenes": ["workbench", "audit"],
      "composes": ["Empty", "ErrorStateBlock", "Loading"],
      "slots": ["default"],
      "antiPatterns": ["列表体自建 loading/empty 分支", "Card 包裹列表行"],
      "localeKeys": ["feedback.empty.*", "feedback.errorState.*"],
      "duty": "编排列表体的加载、失败、空、无权限与有数据分支",
      "dispatchRole": "content-host",
      "handlesStates": ["initial", "loading", "ready", "empty", "partial_error", "error", "forbidden"],
      "feedbackChannel": "both",
      "stateEntry": "regionState",
      "decisions": [
        {"intent": "空与无结果分支可区分", "sceneRef": "筛选后无匹配", "manifestation": "hasFilter 驱动 Empty 文案分支"},
        {"intent": "10 态语义进接入", "sceneRef": "Shell 统一编排", "manifestation": "regionState prop 覆盖布尔分支"},
        {"intent": "无权限不伪装为空", "sceneRef": "责任范围不足", "manifestation": "forbidden 独立分支与 #forbidden-action"}
      ]
    },
    "DataTable": {
      "surfaces": ["list"],
      "scenes": ["workbench", "audit"],
      "composes": ["Table", "Pagination", "Empty", "Loading", "Search"],
      "slots": ["toolbar", "footer"],
      "antiPatterns": ["Card wrapping DataTable", "padding on page root", "页内重复筛选条"],
      "replaces": ["Table"],
      "localeKeys": ["dataDisplay.dataTable.*", "dataDisplay.table.*"],
      "duty": "编排表格行展示、选择与批量操作区域",
      "dispatchRole": "content-host",
      "decisions": [
        {"intent": "让列表页不裸用 Table", "sceneRef": "标准 CRUD 列表", "manifestation": "registry 替代 Table；antiPattern Card 包裹"},
        {"intent": "让批量选择与行操作同区可辨", "sceneRef": "工作台任务队列", "manifestation": "toolbar/footer slot + BatchSelector 组合"},
        {"intent": "让状态分支委托 Shell 而非表格内部", "sceneRef": "加载/空/错", "manifestation": "delegatesStatesTo AdminWorkList 或外层 Shell"}
      ]
    },
    "LayoutSider": {
      "surfaces": ["list"],
      "scenes": ["workbench"],
      "composes": ["Menu", "Collapse"],
      "slots": ["default", "footer"],
      "antiPatterns": ["页面级直接使用 LayoutSider", "与 AppShell 平行双导航"],
      "localeKeys": ["navigation.menu.*"],
      "duty": "承载侧栏导航结构与折叠布局",
      "dispatchRole": "chrome-host"
